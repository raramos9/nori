{
  "name": "nori",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nori": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config explorer/vite.config.ts",
    "dev": "vite --config explorer/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p explorer/tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.7",
    "playwright-core": "1.49.1",
    "typescript6": "npm:typescript@^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.1.6",
    "vitest": "^5.0.5"
  }
}
